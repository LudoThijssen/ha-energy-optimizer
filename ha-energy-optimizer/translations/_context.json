    "example_nl": "Zonnestraling"
  },
  "system.min_discharge_price": {
    "context": "The minimum electricity price (€/kWh) at which the optimizer will allow the battery to discharge. Below this price it is not worth discharging.",
    "example_nl": "Minimale prijs voor ontladen"
  },
  "system.max_charge_price": {
    "context": "The maximum electricity price (€/kWh) at which the optimizer will allow charging the battery from the grid. Above this price it is too expensive to charge.",
    "example_nl": "Maximale prijs voor opladen"
  },
  "system.solar_reserve_strategy": {
    "context": "Setting label. Chooses how the optimizer reserves home battery capacity ahead of an expected NEGATIVE electricity export price window, so upcoming free solar power isn't forced to be sold to the grid at a loss.",
    "example_nl": "Batterijruimte reserveren voor zon"
  },
  "system.solar_reserve_strategy.block": {
    "context": "One of two choices for system.solar_reserve_strategy. 'Block': the optimizer will NOT charge the home battery from the grid at all while forecasted solar production alone is expected to be enough to fill the battery before the negative price window, even if the current grid price is otherwise attractive.",
    "example_nl": "Blokkeren — helemaal niet van het net laden als zon straks genoeg is"
  },
  "system.solar_reserve_strategy.throttle": {
    "context": "One of two choices for system.solar_reserve_strategy. 'Throttle': the optimizer may still charge the home battery from the grid at an attractive price, but caps how much so there remains enough free capacity for the forecasted solar before the negative price window.",
    "example_nl": "Temperen — wel laden, maar ruimte overhouden voor zon"
  },
  "system.solar_reserve_strategy.hint": {
    "context": "Explanatory help text shown under the system.solar_reserve_strategy setting on the System settings page of a home energy management app.",
    "example_nl": "Bepaalt wat de optimizer doet als er een negatief exportprijsvenster wordt verwacht én er genoeg zon voorspeld is om de batterij te vullen. Buiten die situatie verandert deze instelling niets — normaal prijsgedreven laden (ook bij een lage of negatieve prijs) blijft gewoon mogelijk."
  },
